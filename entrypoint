#!/bin/sh

# 设置默认配置路径和文件名
: ${CONFIG_PATH:=/config}
: ${CONFIG_FILE:=config.yaml}

# 拼接完整的配置文件路径
FULL_CONFIG_PATH="${CONFIG_PATH}/${CONFIG_FILE}"

echo "Using config path: $CONFIG_PATH"
echo "Using config file: $CONFIG_FILE"
echo "Full config file path: $FULL_CONFIG_PATH"

# 配置目录就是CONFIG_PATH
CONFIG_DIR="$CONFIG_PATH"

# 确保配置目录存在
if [ ! -d "$CONFIG_DIR" ]; then
    echo "Creating config directory: $CONFIG_DIR"
    mkdir -p "$CONFIG_DIR"
fi

# 检查并设置PGID和PUID的默认值
: ${PGID:=1000}
: ${PUID:=1000}

echo "Setting PGID to $PGID and PUID to $PUID"

# 修改组ID
if [ "$PGID" != "1000" ]; then
    groupmod -o -g "${PGID}" watch-docker
fi

# 修改用户ID
if [ "$PUID" != "1000" ]; then
    usermod -o -u "${PUID}" watch-docker
fi

# 隔离运行用户的 HOME，避免对宿主机 /root 或只读程序目录 /app 执行递归 chown
export HOME=/home/watch-docker
if [ ! -d "$HOME" ]; then
    mkdir -p "$HOME"
fi

chown -R watch-docker:watch-docker \
    "$HOME" \
    "$CONFIG_DIR"

# 仅在新建 APP_PATH 目录时设置运行用户属主，避免覆盖宿主机已有目录属主
if [ -n "$APP_PATH" ]; then
    NORMALIZED_APP_PATH="${APP_PATH%/}"
    while [ "$NORMALIZED_APP_PATH" != "${NORMALIZED_APP_PATH%/.}" ]; do
        NORMALIZED_APP_PATH="${NORMALIZED_APP_PATH%/.}"
        NORMALIZED_APP_PATH="${NORMALIZED_APP_PATH%/}"
    done
    [ -z "$NORMALIZED_APP_PATH" ] && NORMALIZED_APP_PATH="/"
    if [ "$NORMALIZED_APP_PATH" != "/" ] && [ ! -d "$NORMALIZED_APP_PATH" ]; then
        mkdir -p "$(dirname "$NORMALIZED_APP_PATH")" || exit 1
        if mkdir "$NORMALIZED_APP_PATH"; then
            chown watch-docker:watch-docker "$NORMALIZED_APP_PATH" || exit 1
        elif [ ! -d "$NORMALIZED_APP_PATH" ]; then
            exit 1
        fi
    fi
fi

# 自动将运行用户加入 docker.sock 所属宿主机组，确保非 root 用户也可访问 Docker Engine
if [ -S /var/run/docker.sock ]; then
    SOCK_GID=$(stat -Lc '%g' /var/run/docker.sock 2>/dev/null || true)
    if [ -n "$SOCK_GID" ] && ! id -G watch-docker | tr ' ' '\n' | grep -qx "$SOCK_GID"; then
        SOCK_GRP=$(awk -F: -v gid="$SOCK_GID" '$3 == gid { print $1; exit }' /etc/group)
        if [ -z "$SOCK_GRP" ]; then
            SOCK_GRP="dockersock"
            if getent group "$SOCK_GRP" >/dev/null 2>&1; then
                groupmod -o -g "$SOCK_GID" "$SOCK_GRP"
            else
                groupadd -o -g "$SOCK_GID" "$SOCK_GRP"
            fi
        fi
        usermod -aG "$SOCK_GRP" watch-docker
    fi
fi

# 设置默认umask
: ${UMASK:=022}
umask "${UMASK}"

echo "Starting notification service as watch-docker user (${PUID}:${PGID})"


# 启动后端服务（仅传用户名使 gosu 通过 initgroups 保留附加组，包括 docker.sock 组）
exec gosu watch-docker /app/watch-docker
